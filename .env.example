# URL pública del sitio, sin barra final. Se usa en canonical, Open Graph, Schema.org y sitemap.
# En Netlify no hace falta definirla: la variable URL la aporta la plataforma.
SITE_URL=https://example.com

# "false" = web de demostración (noindex + robots.txt con Disallow).
# "true"  = permite indexar y genera sitemap.xml.
INDEXABLE=false

# Puerto del servidor local (npm run dev).
PORT=8765
