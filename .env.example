# Variables de entorno opcionales. El modo demo/producción NO se elige aquí: se elige con `modoDemo` en site.config.mjs.

# URL pública del sitio, sin barra final. Solo se usa en modoDemo: true (canonical y Open Graph).
# En Netlify no hace falta definirla: la variable URL la aporta la plataforma.
# Con modoDemo: false manda `sitio.url` de site.config.mjs.
SITE_URL=https://example.com

# Ruta a otro archivo de configuración (por defecto, site.config.mjs en la raíz del proyecto).
# SITE_CONFIG=./otro-negocio.config.mjs

# Puerto del servidor local (npm run dev).
PORT=8765

# WhatsApp de quien enseña la demo (solo dígitos, con prefijo de país). Se usa en la barra de demo y en los botones de
# contacto del salón en modoDemo: true. Sin esta variable se usa un número ficticio. No lo guardes en el repositorio.
# DEMO_WHATSAPP=34XXXXXXXXX
